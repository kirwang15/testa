  "compilerOptions": {
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-dist"
  },
  "include": [
    "content/**/*.ts",
    "lib/**/*.ts",
